{
  "name": "signage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && npm run build:web",
    "build:web": "tsc -p web && vite build --config web/vite.config.ts",
    "dev": "npm run build:web && wrangler dev -c wrangler.library.jsonc",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "input-otp": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
